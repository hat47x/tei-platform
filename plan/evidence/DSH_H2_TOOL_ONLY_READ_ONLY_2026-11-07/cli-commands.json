{
  "schemaVersion": "tei.cli.discovery/v0",
  "scope": "selected-read-only-commands",
  "commands": [
    {
      "name": "version",
      "effect": "read-only",
      "required": [
        "none"
      ],
      "optional": [
        "-json"
      ],
      "output": "text; json when -json"
    },
    {
      "name": "model catalog",
      "effect": "read-only",
      "required": [
        "-workspace"
      ],
      "optional": [
        "-namespace"
      ],
      "output": "json"
    },
    {
      "name": "workspace-files",
      "effect": "read-only",
      "required": [
        "-workspace"
      ],
      "output": "json"
    },
    {
      "name": "inspect",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-subject-kind",
        "-subject-id"
      ],
      "output": "json"
    },
    {
      "name": "view",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-application"
      ],
      "optional": [
        "-format",
        "at most one of -pattern, -package, -command",
        "-input and -execute with -command",
        "-period-state with -execute"
      ],
      "output": "text; json when -format json"
    },
    {
      "name": "trace",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-scope",
        "-subject-kind",
        "-subject-id"
      ],
      "optional": [
        "-direction",
        "-mode",
        "-offset and -limit (full only)",
        "-expected-fingerprint"
      ],
      "output": "json"
    },
    {
      "name": "source-index",
      "effect": "read-only",
      "required": [
        "-workspace"
      ],
      "optional": [
        "-subject-kind and -subject-id together"
      ],
      "output": "json"
    },
    {
      "name": "knowledge-context",
      "effect": "read-only",
      "required": [
        "-workspace"
      ],
      "optional": [
        "-subject-kind",
        "-subject-id",
        "-disclose",
        "-expected-data-design-fingerprint",
        "-expected-disclosure-fingerprint"
      ],
      "output": "json"
    },
    {
      "name": "knowledge-qualify",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-subject-kind",
        "-subject-id",
        "-qualification-requirements"
      ],
      "output": "json"
    },
    {
      "name": "knowledge-review-plan",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-subject-kind",
        "-subject-id"
      ],
      "optional": [
        "-expected-review-plan-fingerprint"
      ],
      "output": "json"
    },
    {
      "name": "knowledge-review-handoff",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-subject-kind",
        "-subject-id",
        "-qualification-requirements"
      ],
      "optional": [
        "-expected-review-handoff-fingerprint"
      ],
      "output": "json"
    },
    {
      "name": "knowledge-review-disclose",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-subject-kind",
        "-subject-id",
        "-review-handoff"
      ],
      "optional": [
        "-expected-review-handoff-fingerprint",
        "-expected-disclosure-fingerprint"
      ],
      "output": "json"
    },
    {
      "name": "knowledge-data-design-candidate-review",
      "effect": "read-only",
      "required": [
        "-workspace",
        "-subject-kind",
        "-subject-id",
        "-data-design-candidate-kind",
        "-data-design-candidate-fingerprint"
      ],
      "optional": [
        "-expected-data-design-fingerprint",
        "-expected-data-design-candidate-evidence-requirement-fingerprint",
        "-expected-data-design-candidate-review-fingerprint"
      ],
      "output": "json"
    },
    {
      "name": "validate",
      "effect": "read-only",
      "required": [
        "exactly one of -workspace or -world"
      ],
      "optional": [
        "-json (workspace only)"
      ],
      "output": "text; json when -workspace -json"
    },
    {
      "name": "world",
      "effect": "read-only",
      "required": [
        "exactly one of -workspace or -world"
      ],
      "output": "json"
    },
    {
      "name": "requirements",
      "effect": "read-only",
      "required": [
        "exactly one of -workspace or -world"
      ],
      "output": "json"
    },
    {
      "name": "plugin-lock",
      "effect": "read-only",
      "required": [
        "exactly one of -workspace or -world"
      ],
      "optional": [
        "-environment"
      ],
      "output": "json"
    },
    {
      "name": "plugin-resolve",
      "effect": "read-only",
      "required": [
        "exactly one of -workspace or -world",
        "-environment"
      ],
      "optional": [
        "-plugin-lock",
        "-diagnostic-candidates"
      ],
      "output": "json"
    },
    {
      "name": "plugin-runtime-plan",
      "effect": "read-only",
      "required": [
        "exactly one of -workspace or -world",
        "-environment",
        "-plugin-lock"
      ],
      "output": "json"
    }
  ]
}

