    "transport": "streamable-http",
    "serverName": "reconnectmock",
    "url": "http://127.0.0.1:8795/mcp/rh",
    "headers": {
      "Authorization": "Bearer RECONNECT_HEADER_CANARY_771",
      "X-Synthetic-Trace": "rh-771"
    },
    "reconnect": {
      "initialDelayMs": 300,
      "maxDelayMs": 1200,
      "maxAttempts": 8
    },
    "failOnStartupError": false
  },
  "headerCanary": "RECONNECT_HEADER_CANARY_771",
  "runs": {
    "midHandshake500": {
      "outagePlan": "fail after 2 requests, for 2 requests",
      "requestsSeen": [
        {
          "n": 1,
          "method": "server/discover",
          "resp": 200
        },
        {
          "n": 2,
          "method": "initialize",
          "resp": 200
        },
        {
          "n": 3,
          "method": "notifications/initialized",
          "resp": 500
        }
      ],
      "retryFollowed": false,
      "outcome": "client stopped; the tool never appeared on a later request"
    },
    "toolsCall500": {
      "outagePlan": "fail after 4 requests, for 2 requests",
      "requestsSeen": [
        {
          "n": 1,
          "method": "server/discover",
          "resp": 200
        },
