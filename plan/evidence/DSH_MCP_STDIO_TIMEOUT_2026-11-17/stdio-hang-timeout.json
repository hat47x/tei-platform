{
  "note": "The stdio child hung on tools/call. toolCallTimeoutMs 3000 ended the call with 'Request timed out'. With a hang longer than the run the child never logged completion; with a 5s hang it survived the timeout, sent a late reply, and the client then sent notifications/cancelled. So the client cancels the request rather than killing the child.",
  "overlay": {
    "transport": "stdio",
    "serverName": "hangmock",
    "toolCallTimeoutMs": 3000,
    "failOnStartupError": false,
    "args": [
      "mcp_stdio_hang.py|hang2.py",
      "<record-dir>",
      "<hang-seconds>"
    ]
  },
  "runLongHang": {
    "hangSeconds": 120,
    "childLoggedCompletion": false,
    "toolResult": {
      "callId": "toolu_1",
      "status": "error",
      "result": "Error: Request timed out"
    },
    "interpretation": "child was gone before the 120s sleep ended (run lasted ~22s)"
  },
  "runShortHang": {
    "hangSeconds": 5,
    "childSurvivedTimeout": true,
    "clientSentCancellation": true,
    "toolResult": {
      "callId": "toolu_1",
      "status": "error",
      "result": "Error: Request timed out"
    },
    "log": [
      {
        "event": "started",
        "t": 0.0
      },
      {
        "event": "request",
        "method": "server/discover",
        "id": "server-discover-probe-1",
        "t": 0.0
      },
      {
        "event": "started",
        "t": 0.0
      },
      {
        "event": "request",
        "method": "initialize",
        "id": 0,
        "t": 0.0
      },
      {
        "event": "request",
        "method": "notifications/initialized",
        "id": null,
        "t": 0.0
      },
      {
        "event": "request",
        "method": "tools/list",
        "id": 1,
        "t": 0.0
      },
      {
        "event": "request",
        "method": "tools/call",
        "id": 2,
        "t": 1.453
      },
      {
        "event": "hanging",
        "forSeconds": 5.0,
        "t": 1.469
      },
      {
        "event": "survived-the-timeout",
        "t": 6.469
      },
      {
        "event": "late-reply-sent",
        "t": 6.469
