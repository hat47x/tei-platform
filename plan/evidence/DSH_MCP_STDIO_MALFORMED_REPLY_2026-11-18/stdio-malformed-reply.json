  },
  "childStaysAliveThenObservation": {
    "keepalive-garbage": "Error: Request timed out",
    "keepalive-truncate": "Error: Request timed out"
  },
  "answers": {
    "exitAfterMalformedBytes": "MCP connection closed",
    "stayAliveAfterMalformedBytes": "Request timed out (bytes were ignored, not rejected)",
    "clientRejectsMalformedBytesPromptly": "not measured",
    "errorDependsOnChildLifetime": true,
    "note": "the data shows that a malformed reply while the child stays alive ends in 'Request timed out' and while it exits ends in 'MCP connection closed'. It does NOT measure how quickly either happens, nor record a parse/reject event."
  },
  "implication": "'MCP connection closed' reports the closed pipe, NOT a parse failure. When the child keeps the pipe open, malformed or truncated output is discarded without any error and the caller simply waits out the timeout. So the same defect (a bad reply) looks like a connection loss in one case and a timeout in another, and neither names the real cause.",
  "caveat": "Five shapes, one tool, one timeout, one 30s keepalive. Whether the bytes are ever parsed after the timeout, and whether a well-formed-but-wrong-shaped reply behaves differently, were not tested.",
  "timingNote": {
    "removedFields": [
      "runElapsedSeconds",
      "elapsedSeconds"
    ],
    "why": "an earlier draft reported 18.3s and 38.0s from the outer shell's stopwatch, which includes DSH startup and shell overhead. Those are NOT tool-call latencies, and 38s even exceeds the 30s keepalive. They have been removed rather than reinterpreted.",
    "whatIsRecorded": "only child-side timestamps (when tools/call arrived and when the child wrote its bytes); no time-to-error was captured for the client side"
  }
}
