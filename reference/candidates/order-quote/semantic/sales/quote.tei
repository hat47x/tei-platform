namespace sales

// 読み取り専用の見積もり入力と結果。注文確定や永続的な更新は含まない。
// 単価・小計はいずれも日本円の整数金額（最小通貨単位）。
data QuoteLine {
    attribute sku type std.code
    attribute quantity type std.integer
    attribute unitPriceMinor type std.integer
}

data QuoteRequest {
    attribute currency type std.code
    relation lines to sales.quote_line many
}

data QuoteResult {
    attribute currency type std.code
    attribute lineCount type std.integer
    attribute subtotalMinor type std.integer
}

capability sales.order.quote_lines {
    input request sales.quote_request
    output sales.quote_result
}
