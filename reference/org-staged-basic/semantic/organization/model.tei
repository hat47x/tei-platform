namespace organization

type PersonId from std.identifier
type OrgUnitId from std.identifier
type MembershipId from std.identifier
type PositionId from std.identifier
type OccupancyId from std.identifier

data Person {
    attribute personId type organization.person_id
}

data OrgUnit {
    attribute orgUnitId type organization.org_unit_id
}

data Position {
    attribute positionId type organization.position_id
    attribute orgUnitId type organization.org_unit_id

    relation unit to organization.org_unit one
        key organization.position.org_unit_id -> organization.org_unit.org_unit_id
}

data Membership {
    attribute membershipId type organization.membership_id
    attribute personId type organization.person_id
    attribute orgUnitId type organization.org_unit_id
    attribute allocation type std.decimal
    attribute validFrom type std.datetime
    attribute knownFrom type std.datetime

    relation person to organization.person one
        key organization.membership.person_id -> organization.person.person_id
    relation unit to organization.org_unit one
        key organization.membership.org_unit_id -> organization.org_unit.org_unit_id
}

data Occupancy {
    attribute occupancyId type organization.occupancy_id
    attribute personId type organization.person_id
    attribute positionId type organization.position_id
    attribute validFrom type std.datetime

    relation person to organization.person one
        key organization.occupancy.person_id -> organization.person.person_id
    relation position to organization.position one
        key organization.occupancy.position_id -> organization.position.position_id
}
