namespace organization

type OrgUnitId from std.identifier
type MembershipId from std.identifier
type PositionId from std.identifier
type OccupancyId from std.identifier
type PersonId from std.identifier
type LegalEntityId from std.identifier
type EmploymentId from std.identifier
type AffiliationId from std.identifier
type RoleId from std.identifier
type RoleAssignmentId from std.identifier
type ResponsibilityId from std.identifier

data Person {
    attribute personId type organization.person_id
}

data LegalEntity {
    attribute legalEntityId type organization.legal_entity_id
}

data Employment {
    attribute employmentId type organization.employment_id
    attribute personId type organization.person_id
    attribute legalEntityId type organization.legal_entity_id

    relation person to organization.person one
        key organization.employment.person_id -> organization.person.person_id
    relation legalEntity to organization.legal_entity one
        key organization.employment.legal_entity_id -> organization.legal_entity.legal_entity_id
}

data Affiliation {
    attribute affiliationId type organization.affiliation_id
    attribute personId type organization.person_id
    attribute legalEntityId type organization.legal_entity_id

    relation person to organization.person one
        key organization.affiliation.person_id -> organization.person.person_id
    relation legalEntity to organization.legal_entity one
        key organization.affiliation.legal_entity_id -> organization.legal_entity.legal_entity_id
}

data OrgUnit {
    attribute orgUnitId type organization.org_unit_id
    attribute supervisorId type organization.org_unit_id
    attribute matrixParentId type organization.org_unit_id

    relation supervisor to organization.org_unit one
        key organization.org_unit.supervisor_id -> organization.org_unit.org_unit_id
    relation matrixParent to organization.org_unit many
        key organization.org_unit.matrix_parent_id -> organization.org_unit.org_unit_id
}

data Position {
    attribute positionId type organization.position_id
    attribute orgUnitId type organization.org_unit_id

    relation unit to organization.org_unit one
        key organization.position.org_unit_id -> organization.org_unit.org_unit_id
}

data Membership {
    attribute membershipId type organization.membership_id
    attribute orgUnitId type organization.org_unit_id
    attribute allocation type std.decimal
    attribute validFrom type std.datetime
    attribute knownFrom type std.datetime

    relation unit to organization.org_unit one
        key organization.membership.org_unit_id -> organization.org_unit.org_unit_id
}

data Occupancy {
    attribute occupancyId type organization.occupancy_id
    attribute positionId type organization.position_id
    attribute validFrom type std.datetime

    relation position to organization.position one
        key organization.occupancy.position_id -> organization.position.position_id
}

data RoleAssignment {
    attribute roleAssignmentId type organization.role_assignment_id
    attribute personId type organization.person_id
    attribute roleId type organization.role_id

    relation person to organization.person one
        key organization.role_assignment.person_id -> organization.person.person_id
    relation role to organization.role one
        key organization.role_assignment.role_id -> organization.role.role_id
}

data Responsibility {
    attribute responsibilityId type organization.responsibility_id
    attribute subjectPersonId type organization.person_id
    attribute objectOrgUnitId type organization.org_unit_id

    relation subject to organization.person one
        key organization.responsibility.subject_person_id -> organization.person.person_id
    relation object to organization.org_unit one
        key organization.responsibility.object_org_unit_id -> organization.org_unit.org_unit_id
}

data Role {
    attribute roleId type organization.role_id
}
