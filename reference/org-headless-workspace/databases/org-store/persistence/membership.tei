persist org_store.membership {
    database org_store
    semantic organization.membership
    table public.org_memberships

    column organization.membership.membership_id -> membership_id storage varchar required
    column organization.membership.person_id -> person_id storage varchar required
    column organization.membership.org_unit_id -> org_unit_id storage varchar required
    column organization.membership.allocation -> allocation storage decimal optional
    column organization.membership.valid_from -> valid_from storage datetime-tz optional
    column organization.membership.known_from -> known_from storage datetime-tz optional

    primary-key organization.membership.membership_id
}
