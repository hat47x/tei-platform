application order_entry {
    uses semantic sales
    uses semantic customer
    uses validation sales.order_line.quantity_positive
    uses validation sales.order.lines_line_number_unique

    database sales {
        target sales_core
        access read-write
        requires {
            contract sales_core.order ^4
        }
    }

    database master {
        target master_data
        access read
        requires {
            contract master_data.customer ^2
        }
    }
}
