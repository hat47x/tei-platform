      "insertedText": "application repair_intake {\n    uses semantic repair_intake\n    uses semantic customer\n\n    database customer_master {\n        target master_data\n        access read\n        requires {\n            contract master_data.customer ^2\n        }\n    }\n}\n"
    },
    {
      "path": "applications/repair-intake/patterns/customer-reference.tei",
      "layer": "application",
      "created": true,
      "afterFingerprint": "sha256:9c20d2661195b466fb978d8c7e726b384e03870a27d159c43baa458174d24d4d",
      "insertedText": "pattern repair_intake.customer_reference reference {\n    relation repair_intake.intake.customer\n    datasource customer_master\n    contract-query {\n        contract master_data.customer\n        query find_by_id\n        input customer.customer.customer_id -\u003e id\n    }\n}\n"
    },
    {
      "path": "semantic/repair-intake/intake.tei",
