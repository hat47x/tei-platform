namespace sales

type OrderId from std.identifier
type OrderLineId from std.identifier
type OrderStatus from std.code

data Order {
    attribute orderId type sales.order_id
    attribute customerId type customer.customer_id
    attribute orderedAt type std.datetime
    attribute status type sales.order_status
    attribute total type std.money
    attribute externalId type std.text
    relation customer to customer.customer one
        key sales.order.customer_id -> customer.customer.customer_id
    relation lines to sales.order_line many
}

data OrderLine {
    attribute orderLineId type sales.order_line_id
    attribute lineNumber type std.integer
    attribute itemCode type std.code
    attribute quantity type std.decimal
    attribute unitPrice type std.money
}

capability sales.order.submit {
    input order sales.order
    output sales.order
}
