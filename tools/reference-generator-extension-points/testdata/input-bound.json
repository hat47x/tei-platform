      "contract": {
        "version": "1",
        "order": 10,
        "inputs": ["amount"],
        "outputs": ["derivedAmount"]
      }
    }
  ],
  "workspaceFiles": [
    {
      "path": "generated/order.go",
      "content": "package generated\n\n// generated order\n"
    },
    {
      "path": "generated/defaults.go",
      "content": "package generated\n\nconst DefaultDerived = \"amount\"\n"
    },
    {
      "path": "case/derived.go",
      "content": "package caseext\n\nfunc Derived(amount int) int { return amount + 20 }\n"
    }
  ]
