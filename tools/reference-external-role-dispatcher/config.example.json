  "roles": [
    {"name": "implementer", "modelIds": ["deepseek-flash", "claude-sonnet", "step-3.7-flash"]},
    {"name": "diagnostician", "modelIds": ["deepseek-flash", "claude-sonnet", "step-3.7-flash"]},
