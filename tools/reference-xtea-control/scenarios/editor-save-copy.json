{
  "name": "editor-save-copy",
  "description": "Change the system name of a disposable MfgOrder.xead copy in the Editor, save it, answer the backup prompt, and verify the written XML. Never run against an original reference model.",
  "steps": [
    { "op": "wait_window", "title": "X-TEA Editor", "timeoutMs": 30000 },
    { "op": "set", "selector": { "path": "0.1.2.0.0.2" }, "value": "EDITOR SAVE TEST" },
    { "op": "invoke", "selector": { "window": "X-TEA Editor", "path": "m.0.5" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "バックアップの確認", "role": "button", "text": "はい" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "state": "absent", "timeoutMs": 30000 },
    { "op": "sleep", "ms": 1500 },
    { "op": "file_contains", "path": "build/editor-fixture/MfgOrder.xead", "contains": "EDITOR SAVE TEST" }
  ]
}
