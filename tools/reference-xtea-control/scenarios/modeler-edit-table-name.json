{
  "name": "modeler-edit-table-name",
  "description": "Open the AT010 table from the Modeler tree, change its table name, save, answer the backup prompt, and verify the written XML. Uses a disposable MfgOrder.xead copy.",
  "steps": [
    { "op": "wait_window", "title": "X-TEA Modeler", "timeoutMs": 30000 },
    { "op": "select", "selector": { "role": "tree" }, "path": [0, 2, 0, 0, 0] },
    { "op": "key", "selector": { "role": "tree" }, "key": "ENTER" },
    { "op": "sleep", "ms": 1000 },
    { "op": "set", "selector": { "window": "X-TEA Modeler", "path": "0.1.2.9.0.2.0.0.1.1.0" }, "value": "部門TEST" },
    { "op": "invoke", "selector": { "window": "X-TEA Modeler", "path": "m.0.7" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "バックアップの確認", "role": "button", "text": "はい" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "state": "absent", "timeoutMs": 30000 },
    { "op": "sleep", "ms": 1500 },
    { "op": "file_contains", "path": "build/modeler-fixture/MfgOrder.xead", "contains": "部門TEST" }
  ]
}
