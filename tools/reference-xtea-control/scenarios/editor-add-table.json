{
  "name": "editor-add-table",
  "description": "Add table 999 TEST_TABLE through the Editor table-list dialog, save, and verify it in the XML. Uses a disposable MfgOrder.xead copy.",
  "steps": [
    { "op": "wait_window", "title": "X-TEA Editor", "timeoutMs": 30000 },
    { "op": "select", "selector": { "role": "tree" }, "path": [0, 1, 0, 0] },
    { "op": "key", "selector": { "role": "tree" }, "key": "ENTER" },
    { "op": "sleep", "ms": 1000 },
    { "op": "invoke_method", "selector": { "role": "window", "window": "X-TEA Editor" }, "method": "jMenuItemXETreeNodeAdd_actionPerformed" },
    { "op": "sleep", "ms": 1000 },
    { "op": "set", "selector": { "window": "テーブル定義の新規追加", "path": "0.1.2" }, "value": "999" },
    { "op": "set", "selector": { "window": "テーブル定義の新規追加", "path": "0.1.12" }, "value": "TEST_TABLE" },
    { "op": "invoke", "selector": { "window": "テーブル定義の新規追加", "role": "button", "text": "OK" }, "settleMs": 1000 },
    { "op": "sleep", "ms": 1000 },
    { "op": "invoke", "selector": { "window": "X-TEA Editor", "path": "m.0.5" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "バックアップの確認", "role": "button", "text": "はい" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "state": "absent", "timeoutMs": 30000 },
    { "op": "sleep", "ms": 1500 },
    { "op": "model_assert_table", "path": "build/editor-fixture/MfgOrder.xead", "tableId": "999", "name": "TEST_TABLE" }
  ]
}
