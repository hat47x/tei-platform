{
  "name": "modeler-change-field-type",
  "description": "Open CDBUMON, open the data type popup, choose TX010, dismiss the key-definition warning, save, and verify the field's data type via the model CLI. Uses a disposable MfgOrder.xead copy.",
  "steps": [
    { "op": "wait_window", "title": "X-TEA Modeler", "timeoutMs": 30000 },
    { "op": "select", "selector": { "role": "tree" }, "path": [0, 2, 0, 0, 0, 0, 0] },
    { "op": "key", "selector": { "role": "tree" }, "key": "ENTER" },
    { "op": "sleep", "ms": 1000 },
    { "op": "invoke_method", "selector": { "role": "window", "window": "X-TEA Modeler" }, "method": "jButtonTableFieldDataTypeChange_actionPerformed" },
    { "op": "sleep", "ms": 1000 },
    { "op": "invoke", "selector": { "role": "menuitem", "text": "TX010" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "テーブル関連におけるデータタイプの不一致", "timeoutMs": 10000 },
    { "op": "invoke", "selector": { "window": "テーブル関連におけるデータタイプの不一致", "role": "button", "text": "OK" }, "settleMs": 500 },
    { "op": "sleep", "ms": 500 },
    { "op": "invoke", "selector": { "window": "X-TEA Modeler", "path": "m.0.7" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "バックアップの確認", "role": "button", "text": "はい" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "バックアップの確認", "state": "absent", "timeoutMs": 30000 },
    { "op": "sleep", "ms": 1500 },
    { "op": "model_assert_field", "path": "build/modeler-fixture/MfgOrder.xead", "tableId": "61", "fieldAlias": "CDBUMON", "dataTypeSortKey": "TX010" }
  ]
}
