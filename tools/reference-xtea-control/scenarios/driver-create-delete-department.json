{
  "name": "driver-create-delete-department",
  "description": "Create a department by copying an existing one, then delete it with the confirmation dialog. Uses only a disposable Skeleton database and leaves the original two rows.",
  "steps": [
    { "op": "wait_window", "title": "1\\.0\\.8|Skeleton|管理", "timeoutMs": 30000 },
    { "op": "set", "selector": { "path": "0.0.5" }, "value": "00000" },
    { "op": "set", "selector": { "path": "0.0.6" }, "value": "0000000000" },
    { "op": "invoke", "selector": { "role": "button", "text": "ログイン|Login" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "1\\.0\\.8", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "role": "button", "text": "部門情報の一覧・保守" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "部門情報の一覧", "timeoutMs": 30000 },
    { "op": "table_row_count", "selector": { "role": "table" }, "equals": 2 },
    { "op": "select", "selector": { "role": "table" }, "row": 0, "column": 0 },
    { "op": "key", "selector": { "role": "table" }, "key": "ENTER" },
    { "op": "wait_window", "title": "関連情報|部門と", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "関連情報|部門と", "role": "button", "text": "F8 部門情報" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "詳細確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "詳細確認", "role": "button", "text": "F7 複写" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "複写", "timeoutMs": 30000 },
    { "op": "set", "selector": { "window": "複写", "path": "0.0.0.2.0.0.0.0.0.0" }, "value": "00003" },
    { "op": "set", "selector": { "window": "複写", "path": "0.0.0.2.0.0.1.0.0.0" }, "value": "DELETE-TEST" },
    { "op": "invoke", "selector": { "window": "複写", "role": "button", "text": "F5 登録" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "複写", "state": "absent", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "関連情報|部門と", "role": "button", "text": "F3 閉じる" }, "settleMs": 500 },
    { "op": "wait_window", "title": "関連情報|部門と", "state": "absent", "timeoutMs": 10000 },
    { "op": "invoke", "selector": { "window": "部門情報の一覧", "role": "button", "text": "F3 閉じる" }, "settleMs": 500 },
    { "op": "wait_window", "title": "部門情報の一覧", "state": "absent", "timeoutMs": 10000 },
    { "op": "invoke", "selector": { "role": "button", "text": "部門情報の一覧・保守" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "部門情報の一覧", "timeoutMs": 30000 },
    { "op": "table_row_count", "selector": { "role": "table" }, "equals": 3 },
    { "op": "select", "selector": { "role": "table" }, "row": 2, "column": 0 },
    { "op": "key", "selector": { "role": "table" }, "key": "ENTER" },
    { "op": "wait_window", "title": "関連情報|部門と", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "関連情報|部門と", "role": "button", "text": "F8 部門情報" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "詳細確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "詳細確認", "role": "button", "text": "F9 削除" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "削除の確認", "timeoutMs": 30000 },
    { "op": "invoke", "selector": { "window": "削除の確認", "role": "button", "text": "はい" }, "settleMs": 1000 },
    { "op": "wait_window", "title": "詳細確認", "state": "absent", "timeoutMs": 30000 },
    { "op": "table_row_count", "selector": { "role": "table" }, "equals": 2 },
    { "op": "invoke", "selector": { "window": "部門情報の一覧", "role": "button", "text": "F3 閉じる" }, "settleMs": 500 }
  ]
}
