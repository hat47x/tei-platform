{
  "schema": "tei.reference.target-profile/v0",
  "id": "cpu-batch",
  "version": "1",
  "description": "CPU時間上限を適用するLinux batch参照",
  "processModel": "batch",
  "storage": "filesystem",
  "network": "none",
  "update": "replace",
  "memoryLimitBytes": 67108864,
  "observability": [
    "stdout",
    "exit-code"
  ],
  "unsupported": [
    "hard-realtime",
    "rolling-update"
  ],
  "generatorId": "long-running-template",
  "cpuTimeLimitSeconds": 1
}
