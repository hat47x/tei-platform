#!/usr/bin/env python3
# Code generated by {{.GeneratorID}} v1 from contract {{.ContractID}}/{{.ContractVersion}}.
# Strategy: {{.Strategy}}. DO NOT EDIT.

import json
import sys
from decimal import Decimal, InvalidOperation, ROUND_HALF_UP

CURRENCY = "{{.Currency}}"
SCALE = {{.Scale}}
INTEGER_DIGITS = {{.IntegerDigits}}


def emit(state, amount=None, currency=None, code=None):
    out = {"state": state}
    if amount is not None:
        out["amount"] = amount
    if currency is not None:
        out["currency"] = currency
    if code is not None:
        out["code"] = code
    json.dump(out, sys.stdout, separators=(",", ":"))
    sys.stdout.write("\n")


def main():
    try:
        data = json.load(sys.stdin)
    except Exception:
        emit("error", code="INPUT_INVALID")
        return

    if (
        "quantity" not in data
        or "unitPrice" not in data
        or data["quantity"] is None
        or data["unitPrice"] is None
    ):
        emit("missing")
        return
    if data.get("currency") != CURRENCY:
        emit("error", code="CURRENCY_MISMATCH")
        return
    if data.get("unit") != data.get("perUnit"):
        emit("error", code="UNIT_MISMATCH")
        return

    try:
        quantity = Decimal(str(data["quantity"]))
        price = Decimal(str(data["unitPrice"]))
        if not quantity.is_finite() or not price.is_finite():
            raise InvalidOperation
        amount = (quantity * price).quantize(
            Decimal(1).scaleb(-SCALE), rounding=ROUND_HALF_UP
        )
    except (InvalidOperation, ValueError):
        emit("error", code="DECIMAL_INVALID")
        return

    integer = abs(int(amount))
    if len(str(integer)) > INTEGER_DIGITS:
        emit("error", code="PRECISION_OVERFLOW")
        return

    emit("present", amount=format(amount, f".{SCALE}f"), currency=CURRENCY)


if __name__ == "__main__":
    main()
