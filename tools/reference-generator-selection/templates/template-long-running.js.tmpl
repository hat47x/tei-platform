#!/usr/bin/env node
// Code generated by {{.GeneratorID}} v1 from contract {{.ContractID}}/{{.ContractVersion}}.
// Strategy: {{.Strategy}}. DO NOT EDIT.

const CURRENCY = "{{.Currency}}";
const SCALE = {{.Scale}};
const INTEGER_DIGITS = {{.IntegerDigits}};

function emit(out) {
  process.stdout.write(JSON.stringify(out) + "\n");
}

function pow10(n) {
  return 10n ** BigInt(n);
}

function parseDecimal(value) {
  if (typeof value !== "string") {
    return null;
  }
  const match = /^([+-]?)(\d+)(?:\.(\d+))?$/.exec(value);
  if (!match) {
    return null;
  }
  const fraction = match[3] || "";
  const digits = BigInt(match[2] + fraction);
  return {
    coefficient: (match[1] === "-" ? -1n : 1n) * digits,
    scale: fraction.length,
  };
}

function roundHalfUp(value, scale) {
  let coefficient = value.coefficient;
  if (value.scale <= scale) {
    coefficient *= pow10(scale - value.scale);
  } else {
    const divisor = pow10(value.scale - scale);
    let quotient = coefficient / divisor;
    const remainder = coefficient % divisor;
    const twice = (remainder < 0n ? -remainder : remainder) * 2n;
    if (twice >= divisor) {
      quotient += coefficient < 0n ? -1n : 1n;
    }
    coefficient = quotient;
  }
  const negative = coefficient < 0n;
  const absolute = negative ? -coefficient : coefficient;
  const integer = absolute / pow10(scale);
  if (integer.toString().length > INTEGER_DIGITS) {
    throw new Error("PRECISION_OVERFLOW");
  }
  const fraction = (absolute % pow10(scale)).toString().padStart(scale, "0");
  return (negative ? "-" : "") + integer.toString() + (scale > 0 ? "." + fraction : "");
}

function handle(input) {
  let data;
  try {
    data = JSON.parse(input);
  } catch {
    emit({ state: "error", code: "INPUT_INVALID" });
    return;
  }
  if (
    !Object.prototype.hasOwnProperty.call(data, "quantity") ||
    !Object.prototype.hasOwnProperty.call(data, "unitPrice") ||
    data.quantity === null ||
    data.unitPrice === null
  ) {
    emit({ state: "missing" });
    return;
  }
  if (data.currency !== CURRENCY) {
    emit({ state: "error", code: "CURRENCY_MISMATCH" });
    return;
  }
  if (data.unit !== data.perUnit) {
    emit({ state: "error", code: "UNIT_MISMATCH" });
    return;
  }
  const quantity = parseDecimal(data.quantity);
  const price = parseDecimal(data.unitPrice);
  if (quantity === null || price === null) {
    emit({ state: "error", code: "DECIMAL_INVALID" });
    return;
  }
  try {
    const amount = roundHalfUp(
      { coefficient: quantity.coefficient * price.coefficient, scale: quantity.scale + price.scale },
      SCALE,
    );
    emit({ state: "present", amount, currency: CURRENCY });
  } catch (error) {
    emit({
      state: "error",
      code: error.message === "PRECISION_OVERFLOW" ? "PRECISION_OVERFLOW" : "DECIMAL_INVALID",
    });
  }
}

require("readline").createInterface({ input: process.stdin, crlfDelay: Infinity })
  .on("line", handle);
