    "xead": {
      "rootKind": "System",
      "supportedFormatVersions": ["1.2"]
    }
  },
  "constructMappings": {
    "xead": {
      "System": {"classification": ["source-metadata"]},
      "Table": {
        "classification": ["three-view-data"],
        "authorityLimits": ["view-placement-is-a-structural-candidate-not-an-accepted-entity"]
      },
      "TableField": {
        "classification": ["three-view-field"],
        "authorityLimits": ["source-field-is-not-an-accepted-attribute"]
      },
      "TableKey": {"classification": ["field-reference-evidence"]},
      "TableKeyField": {"classification": ["field-reference-evidence"]},
      "Function": {
        "classification": ["three-view-function"],
        "authorityLimits": ["view-placement-is-a-structural-candidate-not-an-accepted-function"]
      },
      "IOTable": {"classification": ["relation-evidence"]},
      "IOPanel": {"classification": ["interaction-target"]},
      "IOSpool": {"classification": ["interaction-target"]},
      "Task": {
        "classification": ["three-view-business"],
        "authorityLimits": ["view-placement-is-a-structural-candidate-not-an-accepted-business-process"]
      },
      "TaskAction": {
        "classification": ["three-view-business"],
        "authorityLimits": [
          "view-placement-is-a-structural-candidate-not-an-accepted-business-action",
          "action-without-a-source-id-is-addressable-only-as-an-occurrence"
        ]
      },
